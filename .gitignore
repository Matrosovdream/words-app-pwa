# Global project-level ignores
# (backend/ and frontend/ have their own .gitignore files for stack-specific rules)

# Env / secrets
.env
.env.local
.env.*.local

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs
*.log
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
